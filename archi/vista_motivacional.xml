    <element identifier="id-D1" xsi:type="Driver"><name xml:lang="es">Transformación digital de procesos</name></element>
    <element identifier="id-D2" xsi:type="Driver"><name xml:lang="es">Control del inventario y abastecimiento</name></element>
    <element identifier="id-D3" xsi:type="Driver"><name xml:lang="es">Experiencia del cliente en pedidos</name></element>
    <element identifier="id-D4" xsi:type="Driver"><name xml:lang="es">Decisiones basadas en datos</name></element>
    <element identifier="id-D5" xsi:type="Driver"><name xml:lang="es">Seguridad y continuidad de la información</name></element>
    <element identifier="id-S1" xsi:type="Stakeholder"><name xml:lang="es">Gerencia General</name></element>
    <element identifier="id-S2" xsi:type="Stakeholder"><name xml:lang="es">Área de Ventas</name></element>
    <element identifier="id-S3" xsi:type="Stakeholder"><name xml:lang="es">Área de Almacén y Logística</name></element>
    <element identifier="id-S4" xsi:type="Stakeholder"><name xml:lang="es">Área de Gestión de TI</name></element>
    <element identifier="id-S5" xsi:type="Stakeholder"><name xml:lang="es">Cliente</name></element>
    <element identifier="id-A1" xsi:type="Assessment"><name xml:lang="es">Ventas, inventario y despacho se registran en papel y Excel</name></element>
    <element identifier="id-A2" xsi:type="Assessment"><name xml:lang="es">Las áreas no comparten datos: cada operación se registra varias veces</name></element>
    <element identifier="id-A3" xsi:type="Assessment"><name xml:lang="es">No existe historial de pedidos ni de movimientos de inventario</name></element>
    <element identifier="id-A4" xsi:type="Assessment"><name xml:lang="es">Las decisiones se toman sin indicadores ni información confiable</name></element>
    <element identifier="id-A5" xsi:type="Assessment"><name xml:lang="es">No hay control de acceso ni políticas de seguridad de la información</name></element>
    <element identifier="id-A6" xsi:type="Assessment"><name xml:lang="es">SICO ERP corre en una sola PC y sin respaldo</name></element>
    <element identifier="id-G0" xsi:type="Goal"><name xml:lang="es">Integrar en una plataforma web única la información de ventas, inventario, atención al cliente y gestión estratégica, con datos centralizados, trazables y disponibles en tiempo real</name></element>
    <element identifier="id-G1" xsi:type="Goal"><name xml:lang="es">OD-01 Centralizar la información operativa en una fuente única</name></element>
    <element identifier="id-G2" xsi:type="Goal"><name xml:lang="es">OD-02 Integrar ventas, inventario y despacho en un mismo flujo</name></element>
    <element identifier="id-G3" xsi:type="Goal"><name xml:lang="es">OD-03 Asegurar la trazabilidad de pedidos y movimientos</name></element>
    <element identifier="id-G4" xsi:type="Goal"><name xml:lang="es">OD-04 Proveer información oportuna para decidir</name></element>
    <element identifier="id-G5" xsi:type="Goal"><name xml:lang="es">OD-05 Garantizar el acceso seguro según el rol</name></element>
    <element identifier="id-G6" xsi:type="Goal"><name xml:lang="es">OD-06 Asegurar la disponibilidad y el crecimiento del sistema</name></element>
    <element identifier="id-O1" xsi:type="Outcome"><name xml:lang="es">Información operativa en una base de datos única</name></element>
    <element identifier="id-O2" xsi:type="Outcome"><name xml:lang="es">Cada operación actualiza ventas, inventario y despacho a la vez</name></element>
    <element identifier="id-O3" xsi:type="Outcome"><name xml:lang="es">Historial completo de pedidos y movimientos</name></element>
    <element identifier="id-O4" xsi:type="Outcome"><name xml:lang="es">Reportes y tablero BSC en tiempo real</name></element>
    <element identifier="id-O5" xsi:type="Outcome"><name xml:lang="es">Acceso controlado por roles y comunicaciones cifradas</name></element>
    <element identifier="id-O6" xsi:type="Outcome"><name xml:lang="es">Servicio disponible y recuperable ante fallas</name></element>
    <element identifier="id-V1" xsi:type="Value"><name xml:lang="es">Módulos del MVP operativos en UAT = 100%</name></element>
    <element identifier="id-V2" xsi:type="Value"><name xml:lang="es">Reducción de quiebres de stock ≥ 50%</name></element>
    <element identifier="id-V3" xsi:type="Value"><name xml:lang="es">Ciclo de pedido ≤ 5 pasos</name></element>
    <element identifier="id-V4" xsi:type="Value"><name xml:lang="es">Reportes generados con datos reales en UAT = 100%</name></element>
    <element identifier="id-V5" xsi:type="Value"><name xml:lang="es">Pruebas de autenticación y roles aprobadas = 100%</name></element>
    <element identifier="id-V6" xsi:type="Value"><name xml:lang="es">Disponibilidad en horario operativo ≥ 95%</name></element>
    <element identifier="id-P1" xsi:type="Principle"><name xml:lang="es">P1 Fuente única de datos</name><documentation xml:lang="es">Que cada dato viva en un solo lugar y no en papel, Excel ni PC sueltas (H-01 a H-11). Ámbito: Ambos.</documentation></element>
    <element identifier="id-P2" xsi:type="Principle"><name xml:lang="es">P2 Monolito modular</name><documentation xml:lang="es">Un solo despliegue fácil de mantener, con módulos separados por dominio. Ámbito: Software.</documentation></element>
    <element identifier="id-P3" xsi:type="Principle"><name xml:lang="es">P3 Separación por capas</name><documentation xml:lang="es">Que la lógica de negocio no dependa de HTTP ni de la base de datos, para poder cambiarlos. Ámbito: Software.</documentation></element>
    <element identifier="id-P4" xsi:type="Principle"><name xml:lang="es">P4 Inversión de dependencias</name><documentation xml:lang="es">Que los casos de uso dependan de contratos (puertos), no de implementaciones concretas como SES o Prisma. Ámbito: Software.</documentation></element>
    <element identifier="id-P5" xsi:type="Principle"><name xml:lang="es">P5 Denegar por defecto</name><documentation xml:lang="es">Que una ruta nueva sea inaccesible hasta que se le asigne un permiso explícito. Ámbito: Software.</documentation></element>
    <element identifier="id-P6" xsi:type="Principle"><name xml:lang="es">P6 Sesión revocable y tokens protegidos</name><documentation xml:lang="es">Poder cerrar una sesión de inmediato y evitar que un script robe el token. Ámbito: Software.</documentation></element>
    <element identifier="id-P7" xsi:type="Principle"><name xml:lang="es">P7 Mínimo privilegio</name><documentation xml:lang="es">Que cada usuario tenga solo los permisos de su rol, mediante grupos ROL-*. Ámbito: Ambos.</documentation></element>
    <element identifier="id-P8" xsi:type="Principle"><name xml:lang="es">P8 Segmentación y defensa en profundidad</name><documentation xml:lang="es">Que un equipo comprometido no dé acceso al resto de la red (VLAN, WAF, honeypot, IDS). Ámbito: Infraestructura.</documentation></element>
    <element identifier="id-P9" xsi:type="Principle"><name xml:lang="es">P9 Redundancia sin punto único de falla</name><documentation xml:lang="es">Que la caída de un ISP, un firewall, un switch o la base primaria no detenga el servicio (H-12, H-16). Ámbito: Infraestructura.</documentation></element>
    <element identifier="id-P10" xsi:type="Principle"><name xml:lang="es">P10 Recuperación ante desastres</name><documentation xml:lang="es">Poder restaurar datos y servicio si se pierde el sitio principal (ISO 22301, H-15). Ámbito: Infraestructura.</documentation></element>
    <element identifier="id-P11" xsi:type="Principle"><name xml:lang="es">P11 Almacenamiento privado</name><documentation xml:lang="es">Que documentos y fotos no sean accesibles por URL pública directa. Ámbito: Infraestructura.</documentation></element>
    <element identifier="id-P12" xsi:type="Principle"><name xml:lang="es">P12 Secretos fuera del código</name><documentation xml:lang="es">Que contraseñas y claves no estén en el repositorio ni en variables visibles. Ámbito: Ambos.</documentation></element>
    <element identifier="id-P13" xsi:type="Principle"><name xml:lang="es">P13 Credenciales temporales en despliegue</name><documentation xml:lang="es">Que el pipeline no guarde claves de larga duración que, si se filtran, den acceso permanente a AWS. Ámbito: Infraestructura.</documentation></element>
    <element identifier="id-P14" xsi:type="Principle"><name xml:lang="es">P14 Cifrado en tránsito</name><documentation xml:lang="es">Que los datos viajen cifrados entre usuario, nube, sede y servicios (TLS 1.3, IPSec). Ámbito: Infraestructura.</documentation></element>
    <element identifier="id-P15" xsi:type="Principle"><name xml:lang="es">P15 API versionada y documentada</name><documentation xml:lang="es">Que los clientes (Portal A y B) puedan evolucionar sin romperse y que el contrato sea visible. Ámbito: Software.</documentation></element>
    <element identifier="id-P16" xsi:type="Principle"><name xml:lang="es">P16 Observabilidad</name><documentation xml:lang="es">Detectar fallas de la aplicación (health checks) y de la red o los equipos (CloudWatch, Wazuh) antes de que el usuario las note (H-21). Ámbito: Ambos.</documentation></element>
    <element identifier="id-P17" xsi:type="Principle"><name xml:lang="es">P17 Cómputo elástico y de bajo costo</name><documentation xml:lang="es">Pagar solo el cómputo que se usa, escalando entre 1 y 2 tareas, y encendiendo el entorno por ventanas. Ámbito: Infraestructura.</documentation></element>
    <element identifier="id-P18" xsi:type="Principle"><name xml:lang="es">P18 Dato en sede, cómputo en la nube</name><documentation xml:lang="es">Mantener la base de producción en la sede y usar AWS para la aplicación y los respaldos. Ámbito: Infraestructura.</documentation></element>
    <element identifier="id-Q1" xsi:type="Requirement"><name xml:lang="es">Base de datos única de ventas, inventario y clientes</name></element>
    <element identifier="id-Q2" xsi:type="Requirement"><name xml:lang="es">Módulos integrados por dominio</name></element>
    <element identifier="id-Q3" xsi:type="Requirement"><name xml:lang="es">Alertas automáticas de stock mínimo</name></element>
    <element identifier="id-Q4" xsi:type="Requirement"><name xml:lang="es">Portal del cliente con seguimiento de pedidos</name></element>
    <element identifier="id-Q5" xsi:type="Requirement"><name xml:lang="es">Reportes y tablero BSC</name></element>
    <element identifier="id-Q6" xsi:type="Requirement"><name xml:lang="es">Autenticación, roles y cifrado</name></element>
    <element identifier="id-Q7" xsi:type="Requirement"><name xml:lang="es">Infraestructura híbrida con respaldo y recuperación</name></element>
    <element identifier="id-AC" xsi:type="ApplicationComponent"><name xml:lang="es">Franco's ERP</name></element>
  </elements>

<model xmlns="http://www.opengroup.org/xsd/archimate/3.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengroup.org/xsd/archimate/3.0/ http://www.opengroup.org/xsd/archimate/3.1/archimate3_Diagram.xsd" identifier="id-model-francos-erp">
  <name xml:lang="es">Franco's ERP - Arquitectura Conceptual</name>
  <elements>
    <element identifier="id-S1" xsi:type="Stakeholder"><name xml:lang="es">Gerencia General</name><documentation xml:lang="es">Supervisa la operación y toma decisiones estratégicas.</documentation></element>
    <element identifier="id-S2" xsi:type="Stakeholder"><name xml:lang="es">Área de Ventas</name><documentation xml:lang="es">Gestiona cotizaciones, pedidos y comprobantes.</documentation></element>
    <element identifier="id-S3" xsi:type="Stakeholder"><name xml:lang="es">Área de Inventario / Almacén</name><documentation xml:lang="es">Controla insumos, productos terminados y despachos.</documentation></element>
    <element identifier="id-S4" xsi:type="Stakeholder"><name xml:lang="es">Cliente</name><documentation xml:lang="es">Realiza pedidos y espera atención oportuna.</documentation></element>
    <element identifier="id-D1" xsi:type="Driver"><name xml:lang="es">Registros manuales desarticulados</name><documentation xml:lang="es">Operaciones de ventas, inventario y distribución registradas en papel y hojas de cálculo desarticuladas.</documentation></element>
    <element identifier="id-D2" xsi:type="Driver"><name xml:lang="es">Quiebres de stock</name><documentation xml:lang="es">Quiebres de stock por falta de control y de alertas oportunas.</documentation></element>
    <element identifier="id-D3" xsi:type="Driver"><name xml:lang="es">Pedidos sin visibilidad</name><documentation xml:lang="es">Pedidos atendidos de forma manual y sin visibilidad de su estado.</documentation></element>
    <element identifier="id-D4" xsi:type="Driver"><name xml:lang="es">Decisiones sin indicadores</name><documentation xml:lang="es">Decisiones gerenciales tomadas sin indicadores ni información confiable.</documentation></element>
    <element identifier="id-D5" xsi:type="Driver"><name xml:lang="es">Información sin seguridad</name><documentation xml:lang="es">Información sensible sin políticas de seguridad ni control de acceso.</documentation></element>
    <element identifier="id-GN3" xsi:type="Goal"><name xml:lang="es">Negocio E3: Optimizar la gestión operativa</name><documentation xml:lang="es">Optimizar la gestión operativa y estratégica mediante el uso de tecnologías digitales e información.</documentation></element>
    <element identifier="id-GN7" xsi:type="Goal"><name xml:lang="es">Negocio E7: Optimizar la gestión de pedidos</name><documentation xml:lang="es">Optimizar la gestión de pedidos para mejorar la eficiencia y satisfacción del cliente.</documentation></element>
    <element identifier="id-GT3" xsi:type="Goal"><name xml:lang="es">TI E3: Soluciones empresariales integradas (ERP)</name><documentation xml:lang="es">Implementar soluciones empresariales integradas para la digitalización de procesos operativos y comerciales (ERP).</documentation></element>
    <element identifier="id-GT4" xsi:type="Goal"><name xml:lang="es">TI E4: Inteligencia de negocios (BI)</name><documentation xml:lang="es">Implementar un sistema de inteligencia de negocios (BI) para el análisis y soporte a decisiones estratégicas.</documentation></element>
    <element identifier="id-GT6" xsi:type="Goal"><name xml:lang="es">TI E6: Gobierno de TI</name><documentation xml:lang="es">Establecer un modelo de gobierno de TI alineado a los objetivos del negocio.</documentation></element>
    <element identifier="id-GT7" xsi:type="Goal"><name xml:lang="es">TI E7: Plataforma digital de pedidos</name><documentation xml:lang="es">Implementación de plataforma digital de atención y gestión de pedidos orientada a la experiencia del cliente.</documentation></element>
    <element identifier="id-GT9" xsi:type="Goal"><name xml:lang="es">TI E9: Automatización de procesos clave</name><documentation xml:lang="es">Incrementar la eficiencia operativa mediante la automatización inteligente de procesos clave del negocio.</documentation></element>
    <element identifier="id-R1" xsi:type="Outcome"><name xml:lang="es">Sistema web centralizado</name><documentation xml:lang="es">Registros manuales reemplazados por un sistema web centralizado.</documentation></element>
    <element identifier="id-R2" xsi:type="Outcome"><name xml:lang="es">Inventario trazable con alertas</name><documentation xml:lang="es">Inventario con trazabilidad de movimientos y alertas de stock mínimo.</documentation></element>
    <element identifier="id-R3" xsi:type="Outcome"><name xml:lang="es">Ciclo de venta digital</name><documentation xml:lang="es">Ciclo de venta digital, con seguimiento de pedidos por parte del cliente.</documentation></element>
    <element identifier="id-R4" xsi:type="Outcome"><name xml:lang="es">Reportes y tablero BSC</name><documentation xml:lang="es">Reportes en tiempo real y tablero BSC con KPIs estratégicos.</documentation></element>
    <element identifier="id-R5" xsi:type="Outcome"><name xml:lang="es">Acceso seguro por roles</name><documentation xml:lang="es">Acceso controlado por roles y comunicaciones cifradas.</documentation></element>
    <element identifier="id-OD1" xsi:type="Requirement"><name xml:lang="es">OD-01 Centralizar la información</name><documentation xml:lang="es">Centralizar la información operativa en una base de datos única, eliminando la duplicidad entre registros físicos y digitales. Iniciativas: IM-02, IM-05.</documentation></element>
    <element identifier="id-OD2" xsi:type="Requirement"><name xml:lang="es">OD-02 Integrar procesos</name><documentation xml:lang="es">Integrar los procesos de ventas, inventario y despacho, de modo que cada operación actualice automáticamente la información relacionada. Iniciativas: IM-01, IM-06.</documentation></element>
    <element identifier="id-OD3" xsi:type="Requirement"><name xml:lang="es">OD-03 Asegurar la trazabilidad</name><documentation xml:lang="es">Asegurar la trazabilidad de pedidos, lotes y movimientos de inventario desde su registro hasta su cierre. Iniciativas: IM-04, IM-05.</documentation></element>
    <element identifier="id-OD4" xsi:type="Requirement"><name xml:lang="es">OD-04 Información para decidir</name><documentation xml:lang="es">Proveer información oportuna para la toma de decisiones mediante reportes e indicadores estratégicos. Iniciativa: gestión estratégica.</documentation></element>
    <element identifier="id-OD5" xsi:type="Requirement"><name xml:lang="es">OD-05 Acceso seguro por rol</name><documentation xml:lang="es">Garantizar el acceso seguro a la información según el rol de cada usuario. Transversal.</documentation></element>
    <element identifier="id-OD6" xsi:type="Requirement"><name xml:lang="es">OD-06 Disponibilidad y crecimiento</name><documentation xml:lang="es">Asegurar la disponibilidad del sistema durante el horario operativo y su capacidad de crecer junto con la empresa. Transversal.</documentation></element>
    <element identifier="id-P1" xsi:type="Principle"><name xml:lang="es">Alineamiento estratégico</name><documentation xml:lang="es">Toda funcionalidad del sistema debe responder a un objetivo estratégico de la organización.</documentation></element>
    <element identifier="id-P2" xsi:type="Principle"><name xml:lang="es">Procesos soportados por el sistema</name><documentation xml:lang="es">Los procesos rediseñados deben ejecutarse dentro del sistema y no fuera de él.</documentation></element>
    <element identifier="id-P3" xsi:type="Principle"><name xml:lang="es">Dato único y compartido</name><documentation xml:lang="es">Cada dato se registra una sola vez y es consultado por todas las áreas que lo requieren.</documentation></element>
    <element identifier="id-P4" xsi:type="Principle"><name xml:lang="es">Trazabilidad</name><documentation xml:lang="es">Toda operación debe quedar registrada con su responsable y fecha.</documentation></element>
    <element identifier="id-P5" xsi:type="Principle"><name xml:lang="es">Modularidad</name><documentation xml:lang="es">El sistema se organiza en módulos independientes por dominio de negocio.</documentation></element>
    <element identifier="id-P6" xsi:type="Principle"><name xml:lang="es">Acceso según rol</name><documentation xml:lang="es">Cada usuario accede únicamente a las funciones que requiere su rol.</documentation></element>
    <element identifier="id-P7" xsi:type="Principle"><name xml:lang="es">Disponibilidad y continuidad</name><documentation xml:lang="es">La plataforma debe mantenerse operativa durante el horario de trabajo y recuperarse ante fallas.</documentation></element>
    <element identifier="id-P8" xsi:type="Principle"><name xml:lang="es">Seguridad desde el diseño</name><documentation xml:lang="es">La protección de la información se incorpora desde la concepción del sistema.</documentation></element>
  </elements>

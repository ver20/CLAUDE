  <folder name="Application" id="id-7a8cc0085b704cecb441e6ca66227d66" type="application" />
  <folder name="Technology &amp; Physical" id="id-d52286787c204aca91581b5346ab2af8" type="technology" />
  <folder name="Motivation" id="id-1a86794618e84b389c97e69df424c41b" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="A1 Gerente General" id="id-83787bee926941cc87dcd11f806e3b52"><documentation>Necesidad: Consultar en un solo lugar la información de las áreas, que hoy está en papel y en archivos sueltos.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="E2, Tabla 12: el rol Gerente consulta reportes, BSC y pedidos" /></element>
    <element xsi:type="archimate:Stakeholder" name="A2 Operador de Ventas" id="id-b5425cccafea4d348bbb76e88425a80f"><documentation>Necesidad: Registrar cada pedido una sola vez, con productos elegidos de un catálogo.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="5-Actores-y-Necesidades.md" /></element>
    <element xsi:type="archimate:Stakeholder" name="A3 Operador de Inventarios" id="id-3bc57980da5144c18ef378fd99a2c543"><documentation>Necesidad: Registrar cada movimiento y cada lote, y seguir un producto terminado hasta su lote.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="5-Actores-y-Necesidades.md" /></element>
    <element xsi:type="archimate:Stakeholder" name="A4 Operador de Producción" id="id-88f7766727be4148be28ec260017ddcd"><documentation>Necesidad: Recibir las solicitudes de producción y enviar las de insumos dentro del ERP.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="5-Actores-y-Necesidades.md" /></element>
    <element xsi:type="archimate:Stakeholder" name="A5 Operador de Despacho" id="id-435d7ffe8175477681e75673d59479b2"><documentation>Necesidad: Registrar la preparación y la entrega sobre el mismo pedido que registró Ventas.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="5-Actores-y-Necesidades.md" /></element>
    <element xsi:type="archimate:Stakeholder" name="A6 Analista Estratégico" id="id-52c1f39abbd24bc0b7a019d0f897f9ce"><documentation>Necesidad: Llevar la gestión estratégica (BSC de negocio y de TI) dentro del sistema.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="5-Actores-y-Necesidades.md" /></element>
    <element xsi:type="archimate:Stakeholder" name="A7 Administrador" id="id-954450ea84944ffcb941c98b89410dbe"><documentation>Necesidad: Crear las cuentas y asignarles su rol para que funcione el acceso por rol.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="5-Actores-y-Necesidades.md" /></element>
    <element xsi:type="archimate:Stakeholder" name="A8 Cliente" id="id-977978944f684518b31b55b48d28c15a"><documentation>Necesidad: Contar con un canal de venta en línea.</documentation><property key="Estado" value="Confirmado como actor externo" /><property key="Fuente" value="5-Actores-y-Necesidades.md" /></element>
    <element xsi:type="archimate:Driver" name="DR-01 Digitalización de la gestión operativa, estratégica y comercial" id="id-90b3840a473847b3b66fe492bd392f3f"><documentation>Interno.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="OEN-03 y OET-03 (E3, mapas estratégicos de negocio y de TI)" /></element>
    <element xsi:type="archimate:Driver" name="DR-02 Integración de la información de las áreas" id="id-db726ffe9b544768b24cd3e523c274a3"><documentation>Interno.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="CE0141, islas de información: H-01, H-08, H-09 y H-11" /></element>
    <element xsi:type="archimate:Driver" name="DR-03 Continuidad de la operación" id="id-d613c3790c1547f2b741516fb12d5225"><documentation>Interno. H-07 y H-17 siguen por validar en CE0141.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="CE0141: H-07, H-16, H-17, H-19, H-20 y H-21" /></element>
    <element xsi:type="archimate:Driver" name="DR-04 Protección de los datos personales (Ley 29733)" id="id-ab18078e08ce420e9fe56278df31461d"><documentation>Externo. La inscripción del banco de datos de clientes sigue por validar (P4).</documentation><property key="Estado" value="Confirmado como norma aplicable" /><property key="Fuente" value="Ley N° 29733 y D.S. N° 016-2024-JUS (CE0141 4-Marco-Normativo §2.2; MARCO_NORMATIVO_ERP §2)" /></element>
    <element xsi:type="archimate:Driver" name="DR-05 Trazabilidad de lotes y conservación de registros" id="id-240603fffcaf4d098d6a968b6b165315"><documentation>Externo. El marco del ERP deja el D.L. 1062 «por confirmar»; el Código Tributario está «por validar» en CE0141.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="E3, IM-04: trazabilidad del producto terminado" /></element>
    <element xsi:type="archimate:Assessment" name="EV-01 Las ventas, el inventario y la distribución se anotan en papel y en Excel, sin formato estándar y fuera de todo sistema" id="id-9fb45df049f7466b9db60d5ecafbaf22"><property key="Estado" value="Confirmado" /><property key="Fuente" value="B-01 y B-03 (H-01 a H-05, H-08)" /></element>
    <element xsi:type="archimate:Assessment" name="EV-02 Producción e Insumos registran sus solicitudes en papel y las revisan a mano" id="id-6caf7d965d2342a596ddf609e1a910ee"><property key="Estado" value="Confirmado" /><property key="Fuente" value="E3, procesos 3 y 5: solicitudes en papel revisadas a mano" /></element>
    <element xsi:type="archimate:Assessment" name="EV-03 La organización no tiene una forma de dar seguimiento a su estrategia" id="id-6bba2691946f4696a30df666a1325022"><property key="Estado" value="Confirmado" /><property key="Fuente" value="Sin brecha: 4-Objetivos §4.1 y 3-Brechas §3.5" /></element>
    <element xsi:type="archimate:Assessment" name="EV-04 No hay una base de datos donde se junte la información de las áreas" id="id-e9c25c60fc814222b50114455c27a3de"><property key="Estado" value="Confirmado" /><property key="Fuente" value="B-05 (H-11)" /></element>
    <element xsi:type="archimate:Assessment" name="EV-05 El papel y los archivos de Excel y Word no tienen copia de respaldo" id="id-dd1205b004fe44799f836969299f7c46"><property key="Estado" value="Confirmado" /><property key="Fuente" value="E3, proceso 4: documentos físicos que pueden perderse o dañarse" /></element>
    <element xsi:type="archimate:Assessment" name="EV-06 El correo no se conecta con ningún sistema" id="id-43f0f5f9d5e842abad0700fb78a02e97"><property key="Estado" value="Confirmado" /><property key="Fuente" value="B-04 (H-09)" /></element>
    <element xsi:type="archimate:Assessment" name="EV-07 No hay servidor propio ni nube: los sistemas y los datos viven en PC individuales" id="id-3d46534d160347088eb99661e4bec6bf"><property key="Estado" value="Confirmado" /><property key="Fuente" value="B-12 (H-19, H-20)" /></element>
    <element xsi:type="archimate:Assessment" name="EV-08 La red e internet no tienen redundancia, la red no está segmentada y las fallas no se detectan" id="id-95e96418e3c84fbfa9c859714d9abb30"><property key="Estado" value="Confirmado" /><property key="Fuente" value="B-09, B-11 y B-13 (H-16, H-18, H-21)" /></element>
    <element xsi:type="archimate:Assessment" name="EV-09 No existe un canal de venta en línea" id="id-73501530e38c4cc8b5246fc24c114bc4"><property key="Estado" value="Confirmado" /><property key="Fuente" value="Sin brecha: 5-Actores (A8) y 3-Brechas §3.5" /></element>
    <element xsi:type="archimate:Goal" name="OEN-03 Optimizar la gestión operativa y estratégica mediante el uso de tecnologías digitales e información" id="id-c376799d14f54040be7da5bf6e6cf278"><documentation>Objetivo general de la vista.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="E3, mapa estratégico de negocio (4-Objetivos §4.2)" /></element>
    <element xsi:type="archimate:Goal" name="OET-03 Implementar soluciones empresariales integradas para la digitalización de procesos operativos y comerciales" id="id-ec8ba7b488964dc38574fd783ba762a8"><documentation>Objetivo de TI que soporta OEN-03.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="E3, mapa estratégico de TI (4-Objetivos §4.3)" /></element>
    <element xsi:type="archimate:Goal" name="MT-01 Registrar las ventas, los despachos, el inventario y las solicitudes de producción en el ERP" id="id-6170781b0fe8449888371106c4cfada5"><documentation>Meta: desglose del objetivo, no objetivo nuevo. Gestión operativa (OEN-03). TI-002.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="4-Objetivos §4.5; B-01, B-03, B-06" /></element>
    <element xsi:type="archimate:Goal" name="MT-02 Dar seguimiento a la estrategia de negocio y de TI en el ERP" id="id-f0a1df1bec884487a034a6734df45f75"><documentation>Meta: desglose del objetivo, no objetivo nuevo. Gestión estratégica (OEN-03). TI-002.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="4-Objetivos §4.5; 3-Brechas §3.5" /></element>
    <element xsi:type="archimate:Goal" name="MT-03 Reunir los datos operativos en una sola base, con copia restaurable y acceso por rol" id="id-f55443e1865d4cbbbd16cb1a583ba5fe"><documentation>Meta: desglose del objetivo, no objetivo nuevo. Información (OEN-03). TI-002 y TI-003.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="4-Objetivos §4.5; B-04, B-05, B-10" /></element>
    <element xsi:type="archimate:Goal" name="MT-04 Sostener el ERP en una infraestructura propia y en la nube, redundante, segmentada y monitoreada" id="id-bc21fc18bc4747d8bb88dbce1beed925"><documentation>Meta: desglose del objetivo, no objetivo nuevo. Tecnologías digitales (OEN-03). TI-003.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="4-Objetivos §4.5; B-09, B-11, B-12, B-13" /></element>
    <element xsi:type="archimate:Goal" name="MT-05 Abrir un canal de venta en línea para el cliente" id="id-c5a125c0989240f1bcdf1c745785c98d"><documentation>Meta: desglose del objetivo, no objetivo nuevo. Procesos comerciales (OET-03). TI-002.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="4-Objetivos §4.5, último párrafo; 3-Brechas §3.5" /></element>
    <element xsi:type="archimate:Outcome" name="RE-01 Ventas y despachos registrados en el ERP sobre el mismo pedido" id="id-76fc1454354545fa8e4f55638d9a7bf7"><documentation>Interesados: A2, A5.</documentation></element>
    <element xsi:type="archimate:Outcome" name="RE-02 Inventario de insumos y de producto terminado llevado en el ERP, con cada producto terminado rastreable hasta su lote" id="id-2f401b725e2b4c89b4eb267479301825"><documentation>Interesados: A3.</documentation></element>
    <element xsi:type="archimate:Outcome" name="RE-03 Solicitudes de producción y de insumos tramitadas en el ERP" id="id-9290e7036d40429fba99c33d0abd6df7"><documentation>Interesados: A3, A4.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="E3, IM-02 e IM-03; sprints 5 y 6" /></element>
    <element xsi:type="archimate:Outcome" name="RE-04 Objetivos, KPI e iniciativas del BSC de negocio y de TI con seguimiento en el ERP" id="id-a754267597224c3ba871cf31233b6e3b"><documentation>Interesados: A6.</documentation></element>
    <element xsi:type="archimate:Outcome" name="RE-05 Datos operativos en una sola base, con un respaldo fuera de la sede que se ha restaurado con éxito" id="id-00cf318a51a849acb0a793c23c94d893"><documentation>Interesados: A1, A7.</documentation></element>
    <element xsi:type="archimate:Outcome" name="RE-06 Funciones y datos del ERP accesibles solo según el rol de cada cuenta" id="id-3e39950c83e7410785f0314a6f233361"><documentation>Interesados: A7, A8.</documentation></element>
    <element xsi:type="archimate:Outcome" name="RE-07 ERP en servicio aunque falle un equipo, un enlace o un proveedor" id="id-8f8b9c53a9c043988af4e1fda97e2282"><documentation>Interesados: Todos.</documentation></element>
    <element xsi:type="archimate:Outcome" name="RE-08 Fallas de los componentes del ERP y de la red detectadas y avisadas a un responsable" id="id-6c2018002a9f4576893142c75d247292"><documentation>Interesados: A7.</documentation></element>
    <element xsi:type="archimate:Outcome" name="RE-09 Clientes registrados en la tienda en línea, con su correo verificado" id="id-b932b997e3d24f4cbbcd8a384a42f2d5"><documentation>Interesados: A8.</documentation></element>
    <element xsi:type="archimate:Outcome" name="RE-10 Información de las áreas disponible para la gerencia en un solo lugar" id="id-ad3eab74162d4622b48b3b0afab9bd39"><documentation>Interesados: A1.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="E2, OPR-04: reportes para la gerencia" /></element>
    <element xsi:type="archimate:Value" name="MD-01 Pedidos registrados en el ERP" id="id-ad30c05a88674384b11004432a6f5bd7"><documentation>Qué mide: Ventas registradas en el ERP ÷ comprobantes emitidos en SICO ERP en el periodo.
Línea base (AS-IS): Ninguna venta se registra en un sistema (H-02).
Fuente del dato: Módulo de ventas; SICO ERP.
Meta: por validar; se define en el CE0145 con frecuencia y responsable.</documentation><property key="Estado" value="Meta por validar" /></element>
    <element xsi:type="archimate:Value" name="MD-02 Pedidos con despacho cerrado en el ERP" id="id-f9c3d7ce301046e2930bdb0a2c53de3b"><documentation>Qué mide: Pedidos en estado «entregado» ÷ pedidos despachados en el periodo.
Línea base (AS-IS): La distribución se anota en papel (H-04).
Fuente del dato: Módulo de despacho.
Meta: por validar; se define en el CE0145 con frecuencia y responsable.</documentation><property key="Estado" value="Meta por validar" /></element>
    <element xsi:type="archimate:Value" name="MD-03 Productos terminados rastreables hasta su lote" id="id-fbe09768471044b3aec103af03507498"><documentation>Qué mide: Productos terminados con lote registrado ÷ productos terminados en stock.
Línea base (AS-IS): Los lotes envasados se llevan en un archivo de Excel (H-05).
Fuente del dato: Módulo de inventario.
Meta: por validar; se define en el CE0145 con frecuencia y responsable.</documentation><property key="Estado" value="Meta por validar" /></element>
    <element xsi:type="archimate:Value" name="MD-04 Solicitudes de insumos tramitadas en el ERP" id="id-accbcab657e044eeba04d3c0dff31ace"><documentation>Qué mide: Solicitudes de insumos registradas en el ERP ÷ solicitudes de insumos del periodo.
Línea base (AS-IS): Medio no conocido (H-06, por validar).
Fuente del dato: Módulo de producción e inventario.
Meta: por validar; se define en el CE0145 con frecuencia y responsable.</documentation><property key="Estado" value="Meta por validar" /></element>
    <element xsi:type="archimate:Value" name="MD-05 Objetivos del BSC con seguimiento" id="id-1b284e1274c9424bac9cb5354a80cd2a"><documentation>Qué mide: Objetivos de negocio y de TI con al menos un KPI medido en el periodo ÷ objetivos registrados.
Línea base (AS-IS): No hay seguimiento de la estrategia (4-Objetivos §4.1).
Fuente del dato: Módulo de estrategia.
Meta: por validar; se define en el CE0145 con frecuencia y responsable.</documentation><property key="Estado" value="Meta por validar" /></element>
    <element xsi:type="archimate:Value" name="MD-06 Respaldo verificado" id="id-8b82a6ed36d8427bbdf915a0ccdeb3ef"><documentation>Qué mide: Respaldos diarios completados ÷ días del periodo, y prueba de restauración ejecutada (DB08).
Línea base (AS-IS): No hay base central (H-11) ni copia conocida (H-07, H-17).
Fuente del dato: Bucket de respaldos y servidor de respaldo.
Meta: por validar; se define en el CE0145 con frecuencia y responsable.</documentation><property key="Estado" value="Meta por validar" /></element>
    <element xsi:type="archimate:Value" name="MD-07 Cuentas con permisos solo por rol" id="id-d04bcdfe575d4c4b99008a487df2fbe4"><documentation>Qué mide: Cuentas activas cuyos permisos vienen solo de su rol ÷ cuentas activas.
Línea base (AS-IS): No hay control de acceso que administrar (sección 5, A7).
Fuente del dato: Módulo de usuarios y roles.
Meta: por validar; se define en el CE0145 con frecuencia y responsable.</documentation><property key="Estado" value="Meta por validar" /></element>
    <element xsi:type="archimate:Value" name="MD-08 Disponibilidad del ERP" id="id-90f1d711dad942e08c7782f02386284f"><documentation>Qué mide: Tiempo en servicio ÷ tiempo del periodo.
Línea base (AS-IS): No se puede medir: sin redundancia (H-16) ni monitoreo (H-21).
Fuente del dato: Comprobaciones de salud y alarmas de la nube.
Meta: por validar; se define en el CE0145 con frecuencia y responsable.</documentation><property key="Estado" value="Meta por validar" /></element>
    <element xsi:type="archimate:Value" name="MD-09 Fallas avisadas a un responsable" id="id-cae938f53e314e1c99c53d9f2133140c"><documentation>Qué mide: Fallas con alerta recibida por un responsable ÷ fallas registradas.
Línea base (AS-IS): Las fallas no se detectan (H-21).
Fuente del dato: Monitoreo y registro central de eventos.
Meta: por validar; se define en el CE0145 con frecuencia y responsable.</documentation><property key="Estado" value="Meta por validar" /></element>
    <element xsi:type="archimate:Value" name="MD-10 Clientes con cuenta verificada" id="id-c5cf3519998749b6937979541ea47ce2"><documentation>Qué mide: Clientes registrados en el Portal B con correo verificado, por periodo.
Línea base (AS-IS): No existe canal en línea (A8).
Fuente del dato: Módulo de autenticación y personas.
Meta: por validar; se define en el CE0145 con frecuencia y responsable.</documentation><property key="Estado" value="Meta por validar" /></element>
    <element xsi:type="archimate:Value" name="MD-11 Indicadores consultados por la gerencia" id="id-d5704799e59645a391a54381cc23270c"><documentation>Qué mide: Indicadores de las áreas que el Gerente General consulta en el ERP.
Línea base (AS-IS): No hay un lugar donde se junte la información (H-11).
Fuente del dato: Por definir.
Meta: por evaluar; se define en el CE0145 con frecuencia y responsable.</documentation><property key="Estado" value="Meta por evaluar" /></element>
    <element xsi:type="archimate:Principle" name="P1 Registro único" id="id-c7b63ad879fd4731a9cff6300de0858a"><documentation>Enunciado completo en 2-Principios.md.</documentation><property key="Fuente" value="2-Principios.md" /></element>
    <element xsi:type="archimate:Principle" name="P2 Copia restaurable" id="id-a57096ec166c4864bb4ad5147629ea44"><documentation>Enunciado completo en 2-Principios.md.</documentation><property key="Fuente" value="2-Principios.md" /></element>
    <element xsi:type="archimate:Principle" name="P3 Datos estructurados y validados" id="id-b578b4eb13094f11ab1b9aff27aeca0f"><documentation>Enunciado completo en 2-Principios.md.</documentation><property key="Fuente" value="2-Principios.md" /></element>
    <element xsi:type="archimate:Principle" name="P4 Protección de datos personales" id="id-4312a80fc9f14b01afaf2277c04cee93"><documentation>Enunciado completo en 2-Principios.md.</documentation><property key="Fuente" value="2-Principios.md" /></element>

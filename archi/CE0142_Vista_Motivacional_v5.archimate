  </folder>
  <folder name="Application" id="id-8b7afbb524e14af183973fb5494951ad" type="application" />
  <folder name="Technology &amp; Physical" id="id-630c5eed2d1a46129b178beaa5019ec2" type="technology" />
  <folder name="Motivation" id="id-d7e8d86719aa4e4098af92d4bba9e142" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="A1 Operador de Ventas" id="id-dfe138f40c974fbcbe0f022aa41e35ec"><documentation>Necesidad: Registrar cada pedido una sola vez, con productos elegidos de un catálogo.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="5-Actores-y-Necesidades.md" /></element>
    <element xsi:type="archimate:Stakeholder" name="A2 Operador de Inventarios" id="id-7339856d8054477fad411cc4e3eea9d6"><documentation>Necesidad: Registrar cada movimiento y cada lote, y seguir un producto terminado hasta su lote.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="5-Actores-y-Necesidades.md" /></element>
    <element xsi:type="archimate:Stakeholder" name="A3 Operador de Insumos" id="id-4b9675db3ee24ca1b44944b011966091"><documentation>Necesidad: Registrar cada entrada y salida de insumos y atender las solicitudes de insumos dentro del ERP.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="5-Actores-y-Necesidades.md" /></element>
    <element xsi:type="archimate:Stakeholder" name="A4 Operador de Producción" id="id-909f9cfb34404401bad07048fbd6bc48"><documentation>Necesidad: Recibir las solicitudes de producción y enviar las de insumos dentro del ERP.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="5-Actores-y-Necesidades.md" /></element>
    <element xsi:type="archimate:Stakeholder" name="A5 Operador de Despacho" id="id-cbd23346e5184974854cf13ea375b196"><documentation>Necesidad: Registrar la preparación y la entrega sobre el mismo pedido que registró Ventas.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="5-Actores-y-Necesidades.md" /></element>
    <element xsi:type="archimate:Stakeholder" name="A6 Analista Estratégico" id="id-6611f838425e44968b9bd4274459ee9c"><documentation>Necesidad: Llevar la gestión estratégica (BSC de negocio y de TI) dentro del sistema.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="5-Actores-y-Necesidades.md" /></element>
    <element xsi:type="archimate:Stakeholder" name="A7 Administrador" id="id-39e1b847412842ac9e1e3f3b160d4d49"><documentation>Necesidad: Crear las cuentas y asignarles su rol para que funcione el acceso por rol.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="5-Actores-y-Necesidades.md" /></element>
    <element xsi:type="archimate:Stakeholder" name="A8 Cliente" id="id-ca4239e869424bb1b8a402f4e415e35e"><documentation>Necesidad: Contar con un canal de venta en línea.</documentation><property key="Estado" value="Confirmado como actor externo" /><property key="Fuente" value="5-Actores-y-Necesidades.md" /></element>
    <element xsi:type="archimate:Driver" name="DR-01 Digitalización de la gestión operativa, estratégica y comercial" id="id-172b7cff1e124045812cb76d6011d0d6"><documentation>Interno.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="OEN-03 y OET-03 (E1, mapas estratégicos de negocio y de TI)" /></element>
    <element xsi:type="archimate:Driver" name="DR-02 Integración de la información de las áreas" id="id-575f7467863840539df06a9f7bd76e42"><documentation>Interno.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="CE0141, islas de información: H-01, H-07, H-08 y H-10" /></element>
    <element xsi:type="archimate:Driver" name="DR-03 Continuidad de la operación" id="id-f1aa6f0bba704a2686a036e36c8ca030"><documentation>Interno.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="CE0141: H-06, H-15, H-16, H-18, H-19 y H-20" /></element>
    <element xsi:type="archimate:Driver" name="DR-04 Protección de los datos personales (Ley 29733)" id="id-f85788c243d144a1a9a94b4566ff0f88"><documentation>Externo. La inscripción del banco de datos de clientes sigue por validar (P4).</documentation><property key="Estado" value="Confirmado como norma aplicable" /><property key="Fuente" value="Ley N° 29733 y D.S. N° 016-2024-JUS (CE0141 4-Marco-Normativo §2.2; MARCO_NORMATIVO_ERP §2)" /></element>
    <element xsi:type="archimate:Driver" name="DR-05 Trazabilidad de lotes y conservación de registros" id="id-7b18188f1dcc4c499f3b6e1032d83619"><documentation>Externo. La trazabilidad de los alimentos la exige el D.L. N° 1062 y la conservación de libros y registros, el Código Tributario.</documentation><property key="Estado" value="Confirmado como norma aplicable" /><property key="Fuente" value="D.L. N° 1062 (MARCO_NORMATIVO_ERP §2) y Código Tributario (CE0141 4-Marco-Normativo §2.2)" /></element>
    <element xsi:type="archimate:Assessment" name="EV-01 Las ventas, el inventario y la distribución se anotan en papel y en Excel, y no pasan a ningún sistema" id="id-ac2a79831afb4d36b9a912ad5ea795ef"><property key="Estado" value="Confirmado" /><property key="Fuente" value="B-01 y B-03 (H-01 a H-05, H-07)" /></element>
    <element xsi:type="archimate:Assessment" name="EV-02 Producción e Insumos llevan sus solicitudes e inventario de insumos en papel" id="id-ffff3818d25f4fc3b88133d18af439a8"><property key="Estado" value="Confirmado" /><property key="Fuente" value="B-14 (H-21)" /></element>
    <element xsi:type="archimate:Assessment" name="EV-03 La organización no tiene una forma de dar seguimiento a su estrategia" id="id-7db922653f27411c9fa8a188e1cbcf57"><property key="Estado" value="Confirmado" /><property key="Fuente" value="Sin brecha: 4-Objetivos §4.1 y 3-Brechas §3.5; mapa de procesos TO-BE (Gestión Estratégica)" /></element>
    <element xsi:type="archimate:Assessment" name="EV-04 No hay una base de datos donde se junte la información de las áreas" id="id-3f0a09aaaeaa45abac96d9f0217e1540"><property key="Estado" value="Confirmado" /><property key="Fuente" value="B-05 (H-10)" /></element>
    <element xsi:type="archimate:Assessment" name="EV-05 No existe copia del papel ni respaldo de los archivos de Excel y Word" id="id-a9c001a9926e4a499951f3cbc7914562"><property key="Estado" value="Confirmado" /><property key="Fuente" value="B-09 (H-06, H-16)" /></element>
    <element xsi:type="archimate:Assessment" name="EV-06 El correo no se conecta con ningún sistema" id="id-b268bbb955f74c9eadce8cf0caa12a07"><property key="Estado" value="Confirmado" /><property key="Fuente" value="B-04 (H-08)" /></element>
    <element xsi:type="archimate:Assessment" name="EV-07 No hay servidor propio ni nube: los sistemas y los datos viven en PC individuales" id="id-e58725d5a7424b13973bdd4f4f6c7e53"><property key="Estado" value="Confirmado" /><property key="Fuente" value="B-11 (H-18, H-19)" /></element>
    <element xsi:type="archimate:Assessment" name="EV-08 La red e internet no tienen redundancia, la red no está segmentada y las fallas no se detectan" id="id-9c3290469e9c4fb2b5bc9fe0a52fc2fa"><property key="Estado" value="Confirmado" /><property key="Fuente" value="B-08, B-10 y B-12 (H-15, H-17, H-20)" /></element>
    <element xsi:type="archimate:Assessment" name="EV-09 No existe un canal de venta en línea" id="id-3855d7475dc040978dd9a16335f7b91e"><property key="Estado" value="Confirmado" /><property key="Fuente" value="Sin brecha: 5-Actores (A8) y 3-Brechas §3.5" /></element>
    <element xsi:type="archimate:Goal" name="OEN-03 Optimizar la gestión operativa y estratégica mediante el uso de tecnologías digitales e información" id="id-c17f17c5e92c4472831906ff130991da"><documentation>Objetivo general de la vista.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="E1, CE0112: mapa estratégico del negocio (4-Objetivos §4.2)" /></element>
    <element xsi:type="archimate:Goal" name="OET-03 Implementar soluciones empresariales integradas para la digitalización de procesos operativos y comerciales" id="id-b58c2df590e54428931e8a462d8a7681"><documentation>Objetivo de TI que soporta OEN-03.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="E1, CE0112: mapa estratégico de TI (4-Objetivos §4.3)" /></element>
    <element xsi:type="archimate:Goal" name="MT-01 Registrar las ventas, los despachos, el inventario y las solicitudes de producción en el ERP" id="id-b220c28190d14f8384deb05ef255864e"><documentation>Meta: desglose del objetivo, no objetivo nuevo. Gestión operativa (OEN-03). TI-002.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="4-Objetivos §4.5; B-01, B-03, B-14" /></element>
    <element xsi:type="archimate:Goal" name="MT-02 Dar seguimiento a la estrategia de negocio y de TI en el ERP" id="id-6a38b83dc5394e6bafb717ef5d23bb57"><documentation>Meta: desglose del objetivo, no objetivo nuevo. Gestión estratégica (OEN-03). TI-002.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="4-Objetivos §4.5; 3-Brechas §3.5; mapa de procesos TO-BE (Gestión Estratégica)" /></element>
    <element xsi:type="archimate:Goal" name="MT-03 Reunir los datos operativos en una sola base, con copia restaurable y acceso por rol" id="id-c447d96c15e84891b30ceb28159e932e"><documentation>Meta: desglose del objetivo, no objetivo nuevo. Información (OEN-03). TI-002 y TI-003.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="4-Objetivos §4.5; B-04, B-05, B-09" /></element>
    <element xsi:type="archimate:Goal" name="MT-04 Sostener el ERP en una infraestructura propia y en la nube, redundante, segmentada y monitoreada" id="id-2c28b78b47cd4eee80ccd771af12139b"><documentation>Meta: desglose del objetivo, no objetivo nuevo. Tecnologías digitales (OEN-03). TI-003.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="4-Objetivos §4.5; B-08, B-10, B-11, B-12" /></element>
    <element xsi:type="archimate:Goal" name="MT-05 Abrir un canal de venta en línea para el cliente" id="id-192a4df1ee394e86b2c45f30a0b08cf5"><documentation>Meta: desglose del objetivo, no objetivo nuevo. Procesos comerciales (OET-03). TI-002.</documentation><property key="Estado" value="Confirmado" /><property key="Fuente" value="4-Objetivos §4.5, último párrafo; 3-Brechas §3.5" /></element>
    <element xsi:type="archimate:Outcome" name="RE-01 Ventas y despachos registrados en el ERP sobre el mismo pedido" id="id-3f38e31b16ad4640bd63d31abe943d40"><documentation>Interesados: A1, A5.</documentation></element>
    <element xsi:type="archimate:Outcome" name="RE-02 Inventario de insumos y de producto terminado llevado en el ERP, con cada producto terminado rastreable hasta su lote" id="id-bf51499dacab4339b173fc5372d1233d"><documentation>Interesados: A2, A3.</documentation></element>
    <element xsi:type="archimate:Outcome" name="RE-03 Solicitudes de producción y de insumos tramitadas en el ERP" id="id-cbe2aac6471e4f57b88d1264d6097456"><documentation>Interesados: A2, A3, A4.</documentation></element>
    <element xsi:type="archimate:Outcome" name="RE-04 Objetivos, KPI e iniciativas del BSC de negocio y de TI con seguimiento en el ERP" id="id-78143d2b324e4e9d99c677c5a653f6dd"><documentation>Interesados: A6.</documentation></element>
    <element xsi:type="archimate:Outcome" name="RE-05 Datos operativos en una sola base, con un respaldo fuera de la sede que se ha restaurado con éxito" id="id-bb0c0f967a084ab8afa02bd9b7bef5d1"><documentation>Interesados: A7.</documentation></element>
    <element xsi:type="archimate:Outcome" name="RE-06 Funciones y datos del ERP accesibles solo según el rol de cada cuenta" id="id-f37e16a64b5744ff90ae8e32ad8d3970"><documentation>Interesados: A7, A8.</documentation></element>
    <element xsi:type="archimate:Outcome" name="RE-07 ERP en servicio aunque falle un equipo, un enlace o un proveedor" id="id-a4284e603c0f4e7eac7da05d56c50863"><documentation>Interesados: Todos.</documentation></element>
    <element xsi:type="archimate:Outcome" name="RE-08 Fallas de los componentes del ERP y de la red detectadas y avisadas a un responsable" id="id-45e1822906e749098439016c1e3fa73a"><documentation>Interesados: A7.</documentation></element>
    <element xsi:type="archimate:Outcome" name="RE-09 Clientes registrados en la tienda en línea, con su correo verificado" id="id-70a77ed77e7b477bab8227d5116bfadb"><documentation>Interesados: A8.</documentation></element>
    <element xsi:type="archimate:Value" name="MD-01 Pedidos registrados en el ERP" id="id-f7d36ac6ca8641d19f51f2ed44536e68"><documentation>Qué mide: Ventas registradas en el ERP ÷ comprobantes emitidos en SICO ERP en el periodo.
Línea base (AS-IS): Ninguna venta se registra en un sistema (H-02).
Fuente del dato: Módulo de ventas; SICO ERP.
Meta: se define en el CE0145 con frecuencia y responsable.</documentation><property key="Estado" value="Meta definida en el CE0145" /></element>
    <element xsi:type="archimate:Value" name="MD-02 Pedidos con despacho cerrado en el ERP" id="id-c8ebf2f022f7434086b839970034bb11"><documentation>Qué mide: Pedidos en estado «entregado» ÷ pedidos despachados en el periodo.
Línea base (AS-IS): La distribución se anota en papel (H-04).
Fuente del dato: Módulo de despacho.
Meta: se define en el CE0145 con frecuencia y responsable.</documentation><property key="Estado" value="Meta definida en el CE0145" /></element>
    <element xsi:type="archimate:Value" name="MD-03 Productos terminados rastreables hasta su lote" id="id-4fd2694ac5614c11bcfc351349f019a1"><documentation>Qué mide: Productos terminados con lote registrado ÷ productos terminados en stock.
Línea base (AS-IS): Los lotes envasados se llevan en un archivo de Excel (H-05).
Fuente del dato: Módulo de inventario.
Meta: se define en el CE0145 con frecuencia y responsable.</documentation><property key="Estado" value="Meta definida en el CE0145" /></element>
    <element xsi:type="archimate:Value" name="MD-04 Solicitudes de insumos tramitadas en el ERP" id="id-c4eee213ba0845f5915a5b80cd8a0860"><documentation>Qué mide: Solicitudes de insumos registradas en el ERP ÷ solicitudes de insumos del periodo.
Línea base (AS-IS): Las solicitudes de insumos van en papel (H-21).
Fuente del dato: Módulo de producción e inventario de insumos.
Meta: se define en el CE0145 con frecuencia y responsable.</documentation><property key="Estado" value="Meta definida en el CE0145" /></element>
    <element xsi:type="archimate:Value" name="MD-05 Objetivos del BSC con seguimiento" id="id-0ad18dfcd89549b99c5134fda875a5d1"><documentation>Qué mide: Objetivos de negocio y de TI con al menos un KPI medido en el periodo ÷ objetivos registrados.
Línea base (AS-IS): No hay seguimiento de la estrategia (4-Objetivos §4.1).
Fuente del dato: Módulo de estrategia.
Meta: se define en el CE0145 con frecuencia y responsable.</documentation><property key="Estado" value="Meta definida en el CE0145" /></element>
    <element xsi:type="archimate:Value" name="MD-06 Respaldo verificado" id="id-7f07f966514f4276aeeb3148c557f362"><documentation>Qué mide: Respaldos diarios completados ÷ días del periodo, y prueba de restauración ejecutada (DB08).
Línea base (AS-IS): No hay base central (H-10) ni copia de los registros (H-06, H-16).
Fuente del dato: Bucket de respaldos (volcado diario) y VM de respaldo de la sede.
Meta: se define en el CE0145 con frecuencia y responsable.</documentation><property key="Estado" value="Meta definida en el CE0145" /></element>
    <element xsi:type="archimate:Value" name="MD-07 Cuentas con permisos solo por rol" id="id-0fdf694e453c4092876f6924a4dd6102"><documentation>Qué mide: Cuentas activas cuyos permisos vienen solo de su rol ÷ cuentas activas.
Línea base (AS-IS): No hay control de acceso que administrar (sección 5, A7).
Fuente del dato: Módulo de usuarios y roles.
Meta: se define en el CE0145 con frecuencia y responsable.</documentation><property key="Estado" value="Meta definida en el CE0145" /></element>
    <element xsi:type="archimate:Value" name="MD-08 Disponibilidad del ERP" id="id-89e474d90b714141b0c03931e45f2e19"><documentation>Qué mide: Tiempo en servicio ÷ tiempo del periodo.
Línea base (AS-IS): No se puede medir: sin redundancia (H-15) ni monitoreo (H-20).
Fuente del dato: Lambda sonda y alarmas de CloudWatch; monitoreo de la sede.
Meta: se define en el CE0145 con frecuencia y responsable.</documentation><property key="Estado" value="Meta definida en el CE0145" /></element>
    <element xsi:type="archimate:Value" name="MD-09 Fallas avisadas a un responsable" id="id-dc2659394244481bb0738e5f6d415295"><documentation>Qué mide: Fallas con alerta recibida por un responsable ÷ fallas registradas.
Línea base (AS-IS): Las fallas no se detectan (H-20).
Fuente del dato: Monitoreo y registro central de eventos.
Meta: se define en el CE0145 con frecuencia y responsable.</documentation><property key="Estado" value="Meta definida en el CE0145" /></element>
    <element xsi:type="archimate:Value" name="MD-10 Clientes con cuenta verificada" id="id-47b41ebbee6f44d9a43f346033aa67bb"><documentation>Qué mide: Clientes registrados en el Portal B con correo verificado, por periodo.
Línea base (AS-IS): No existe canal en línea (A8).
Fuente del dato: Módulo de autenticación y personas.
Meta: se define en el CE0145 con frecuencia y responsable.</documentation><property key="Estado" value="Meta definida en el CE0145" /></element>
    <element xsi:type="archimate:Principle" name="P1 Registro único" id="id-98a2821305d74dceb6739e7d13583e62"><documentation>Enunciado completo en 2-Principios.md.</documentation><property key="Fuente" value="2-Principios.md" /></element>
    <element xsi:type="archimate:Principle" name="P2 Copia restaurable" id="id-4224ea3b72e64dd1b0471f369cbb2277"><documentation>Enunciado completo en 2-Principios.md.</documentation><property key="Fuente" value="2-Principios.md" /></element>
    <element xsi:type="archimate:Principle" name="P3 Datos estructurados y validados" id="id-20f6dc2d17e146ffbe75e81b8d730a40"><documentation>Enunciado completo en 2-Principios.md.</documentation><property key="Fuente" value="2-Principios.md" /></element>
    <element xsi:type="archimate:Principle" name="P4 Protección de datos personales" id="id-5101e8cbed614cd2979fe7b98a3df3da"><documentation>Enunciado completo en 2-Principios.md.</documentation><property key="Fuente" value="2-Principios.md" /></element>
